{% include 'layout/base.html' %} {% block body %}
<section
  style="height: 90vh"
  class="d-flex align-items-center justify-content-center"
>
  <div id="bento" class="text-center">
    <div class="row">
      <div
        class="font-varela d-flex align-items-center justify-content-center col-6 border rounded-md fs-2 p-3"
        style="flex-direction: column"
      >
        <span class="font-bold"
          >Total<br />
          Advertisements:</span
        >
        {{ advertisements | length }}
        <div class="d-flex justify-content-center align-items-center gap-2">
          <a
            href="/advertisements/create"
            class="btn btn-primary d-flex align-items-center justify-content-center gap-1"
          >
            <ion-icon name="add-outline"></ion-icon>
            Create new Advertisement
          </a>
          <a href="/advertisements" class="btn-primary btn"
            >View all Advertisements</a
          >
        </div>
      </div>
      <div
        class="font-varela d-flex align-items-center justify-content-center col-6 border rounded-md fs-2 p-3"
        style="flex-direction: column"
      >
        <span class="font-bold"
          >Total<br />
          Campaigns:</span
        >
        {{ campaigns | length }}
        <div class="d-flex justify-content-center align-items-center gap-2">
          <a
            class="btn btn-primary d-flex align-items-center justify-content-center gap-1"
            href="/campaigns/create"
          >
            <ion-icon name="add-outline"></ion-icon>Create new Campaign
          </a>
          <a href="/campaigns" class="btn btn-primary">View All Campaigns</a>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
